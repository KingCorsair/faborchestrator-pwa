# Keeps the build context small and, more importantly, keeps secrets and
# personal files out of an image that is going to sit on a public URL.
#
# `flyctl deploy` uploads this directory as the build context. Anything not
# excluded here is sent to the builder and can end up in a layer.

node_modules/
.next/
out/
build/

# Never. Runtime configuration is set as Fly secrets, not baked into a layer.
.env
.env.local
.env*.local
*.pem

.git/
.gitignore

# Generated per deployment, and it encodes the app's own URL.
qr/

# Build artefacts and working files that have no business in an image.
*.tsbuildinfo
__tests__/

# Screenshots the live checks in scripts/ leave in the root (see .gitignore).
/wp*.png

.DS_Store
npm-debug.log*
Dockerfile
.dockerignore
