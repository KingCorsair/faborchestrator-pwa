# QR codes written by scripts/generate-qr.ts. Each one encodes a specific
# deployment's URL, so a committed copy is a link that goes stale silently.
qr/

# Screenshots the live checks in scripts/ write to the repository root
# (mobile-audit, artifact-live-check, progress-states-check). Evidence of one
# run against one deployment — regenerated every time, never source.
/wp*.png

.DS_Store
*.pem
npm-debug.log*

# The Vercel CLI's link to the project (`vercel link`), local to one machine.
# Its `.env.local` is covered by the `.env*.local` line above.
.vercel
