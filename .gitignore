/public/zxing/
out/
build/
next-env.d.ts
*.tsbuildinfo

.env
.env.local
.env*.local

# QR codes written by scripts/generate-qr.ts. Each one encodes a specific
# deployment's URL, so a committed copy is a link that goes stale silently.
qr/

.DS_Store
*.pem
npm-debug.log*

# Design-review harness output — regenerated by design-review/render.tsx
design-review/out/

# The design-review export zip is a build artifact
faborchestrator-design-review.zip

# ...and so is the folder it is zipped from — a copy of design-review/out/ kept
# only so the archive has a sensible top-level name. Tracking it would version
# the same generated HTML twice, and it is where a stale nested copy of an
# earlier export appeared on 2026-08-12.
faborchestrator-design-review/
