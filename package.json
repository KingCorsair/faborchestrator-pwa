{
  "name": "faborchestrator-pwa-demo",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --port 3002",
    "build": "next build",
    "start": "next start --port 3002",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "icons": "npx tsx scripts/generate-icons.ts",
    "test:platform": "npx tsx --test \"__tests__/platform/*.test.ts\"",
    "test": "npm run test:platform && npm run test:faborch",
    "qr": "npx tsx scripts/generate-qr.ts",
    "test:faborch": "npx tsx --test \"__tests__/faborch/*.test.ts\""
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "lucide-react": "^0.473.0",
    "next": "16.1.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^2.6.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.1.4",
    "playwright": "^1.62.1",
    "qrcode": "^1.5.4",
    "tailwindcss": "^4",
    "tsx": "^4.19.2",
    "typescript": "^5",
    "zxing-wasm": "^2.2.0"
  },
  "engines": {
    "node": ">=20.11"
  }
